  "components": {
    "schemas": {
      "Body_resume_api_v1_profile_resume_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_resume_api_v1_profile_resume_post"
      },
      "Comparison": {
        "properties": {
          "job_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Job Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_ids"
        ],
        "title": "Comparison"
      },
      "Consent": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "allowed"
        ],
        "title": "Consent"
      },
      "Constraints": {
        "properties": {
          "exclude_mode": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "remote",
                    "onsite",
                    "hybrid"
                  ]
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude Mode"
          },
          "exclude_employment": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "internship",
                    "full-time"
                  ]
                },
                "type": "array",
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude Employment"
          },
          "verified_only": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified Only"
          },
          "employment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "internship",
                  "full-time"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Employment"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "remote",
                  "onsite",
                  "hybrid"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "graduation_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2100.0,
                "minimum": 1950.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Graduation Year"
          },
          "min_salary": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Salary"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "INR",
                  "USD",
                  "EUR"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "month",
                  "year",
                  "hour"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "max_experience": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Experience"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Constraints"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
